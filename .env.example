# App
APP__ENVIRONMENT=dev
APP__LOG_LEVEL=INFO

# LLM Gateway
LLM__GROQ_API_KEY=
LLM__GROQ_MODEL=openai/gpt-oss-20b
LLM__GEMINI_API_KEY=
LLM__GEMINI_MODEL=gemini-flash-latest
LLM__JUDGE_PROVIDER=gemini

# Vector DB (self-hosted Qdrant)
VECTORDB__HOST=qdrant
VECTORDB__PORT=6333
VECTORDB__COLLECTION_NAME=financial_reports

# Database (Supabase Postgres)
DATABASE__URL=

# Redis (self-hosted)
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__CACHE_DB=0
REDIS__CELERY_DB=1

# MCP Client (self-hosted Financial Data MCP Server)
MCP__SERVER_URL=http://mcp-server:8000/mcp
MCP__AUTH_TOKEN=

# Security
SECURITY__BEARER_TOKEN=
SECURITY__RATE_LIMIT_PER_MINUTE=60

# Monitoring
MONITORING__LANGSMITH_API_KEY=
MONITORING__LANGSMITH_PROJECT=investor-intelligence-agent
MONITORING__PROMETHEUS_ENABLED=true